{#
  oeil_monthly_brief.html.j2
  CPOI Platform -- OEIL Monthly Intelligence Brief Template (8-10 sections)

  Populated by: reports/generator.py with a MonthlyBriefContext dict.
  Rendered by:  Jinja2 Environment (undefined=StrictUndefined).
  Consumed by:  reports/builder.py (docx and pdf).

  Fixed sections: populated from database values in context dict.
  Narrative sections: populated by reports/narrator.py before render.
    All narrative keys must contain real text (50-300 words).
    NARRATIVE_PLACEHOLDER__ sentinel triggers rejection by validator.

  Governed prompt (SDLC spec Part 5):
    The narrative_executive_summary field must contain output produced
    by the Monthly Brief Narrative Section prompt from the spec verbatim.
    That prompt enforces the 3-paragraph structure:
      P1: Composite score movement and operational intelligence posture.
      P2: Single most material finding and its business implication.
      P3: One governance action most likely to produce measurable
          signal improvement in the next 30 days.

  Score delta convention: positive = worsened, negative = improved.

  Watermark fields (embedded on every page footer):
    {{ client_name }} | {{ sponsor_name }} | {{ report_date }} | {{ report_id }}
#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="report-id" content="{{ report_id }}" />
  <meta name="report-type" content="monthly_brief" />
  <meta name="client-name" content="{{ client_name }}" />
  <meta name="sponsor-name" content="{{ sponsor_name }}" />
  <meta name="report-date" content="{{ report_date }}" />
  <meta name="generated-at" content="{{ generated_at }}" />
  <title>OEI Monthly Intelligence Brief -- {{ client_name }} -- {{ period_label }}</title>
</head>
<body>

{# =========================================================================
   COVER PAGE
   ========================================================================= #}
<section id="cover" data-section="cover" class="report-cover">
  <div class="firm-name">CRITERION PARTNERS</div>
  <div class="report-title">Operational Executive Intelligence Layer</div>
  <div class="report-subtitle">Monthly Intelligence Brief</div>
  <div class="cover-divider"></div>
  <table class="cover-meta">
    <tbody>
      <tr>
        <td class="meta-label">Prepared For</td>
        <td class="meta-value">{{ sponsor_name }}</td>
      </tr>
      <tr>
        <td class="meta-label">Organization</td>
        <td class="meta-value">{{ client_name }}</td>
      </tr>
      <tr>
        <td class="meta-label">Reporting Period</td>
        <td class="meta-value">{{ period_label }}</td>
      </tr>
      {% if prior_period_label %}
      <tr>
        <td class="meta-label">Prior Period</td>
        <td class="meta-value">{{ prior_period_label }}</td>
      </tr>
      {% endif %}
      <tr>
        <td class="meta-label">Report Date</td>
        <td class="meta-value">{{ report_date }}</td>
      </tr>
      <tr>
        <td class="meta-label">Report ID</td>
        <td class="meta-value">{{ report_id }}</td>
      </tr>
    </tbody>
  </table>
  <div class="cover-confidentiality">
    Prepared exclusively for {{ sponsor_name }} -- Confidential<br />
    This report and its contents are the proprietary work product of
    Criterion Partners. Distribution requires written authorization
    from the Managing Partner.
  </div>
</section>

{# =========================================================================
   SECTION 1 -- PERIOD SUMMARY
   ========================================================================= #}
<section id="period-summary" data-section="period_summary" class="report-section">
  <h2>Period Summary</h2>
  <table class="data-table period-summary-table">
    <tbody>
      <tr>
        <td class="field-label">Reporting Period</td>
        <td>{{ reporting_period_start }} to {{ reporting_period_end }}</td>
      </tr>
      <tr>
        <td class="field-label">Data Submission Date</td>
        <td>{{ submitted_at }}</td>
      </tr>
      <tr>
        <td class="field-label">Engagement Start Date</td>
        <td>{{ engagement_start_date }}</td>
      </tr>
      <tr>
        <td class="field-label">OEI Composite Score</td>
        <td>
          <span class="score-value composite" data-classification="{{ composite_class }}">{{ oei_composite_score }}</span>
          <span class="score-classification">{{ composite_class }}</span>
        </td>
      </tr>
      {% if prior_composite_score is not none %}
      <tr>
        <td class="field-label">Prior Period Composite</td>
        <td>{{ prior_composite_score }}</td>
      </tr>
      <tr>
        <td class="field-label">Period Movement</td>
        <td class="score-delta" data-direction="{{ score_direction }}">
          {% if score_delta > 0 %}+{{ score_delta }} points (worsened)
          {% elif score_delta < 0 %}{{ score_delta }} points (improved)
          {% else %}No change
          {% endif %}
        </td>
      </tr>
      {% else %}
      <tr>
        <td class="field-label">Prior Period</td>
        <td>No prior period on record (first submission)</td>
      </tr>
      {% endif %}
    </tbody>
  </table>
  {% if has_override %}
  <p class="override-footnote">{{ override_footnote }}</p>
  {% endif %}
</section>

{# =========================================================================
   SECTION 2 -- SCORE TRAJECTORY CHART
   Rendered only when a chart image was generated (prior periods exist).
   trajectory_chart_b64 is a base64-encoded PNG produced by chart.py.
   ========================================================================= #}
<section id="score-trajectory" data-section="score_trajectory" class="report-section">
  <h2>Score Trajectory</h2>
  {% if trajectory_chart_b64 %}
  <div class="chart-container">
    <img src="data:image/png;base64,{{ trajectory_chart_b64 }}"
         alt="OEI Composite Score Trajectory Chart"
         class="trajectory-chart" />
  </div>
  <p class="section-note">
    Chart shows OEI Composite Score across all recorded periods.
    Higher scores indicate higher operational risk. Score band
    reference lines at 20, 40, 60, and 80.
  </p>
  {% else %}
  <p class="section-note">
    Score trajectory chart is not available for the first reporting period.
    Trend data will appear in subsequent Monthly Intelligence Briefs.
  </p>
  {% endif %}
</section>

{# =========================================================================
   SECTION 3 -- OEI SCORECARD (5 DIMENSIONS + COMPOSITE)
   ========================================================================= #}
<section id="oei-scorecard" data-section="oei_scorecard" class="report-section">
  <h2>OEI Scorecard</h2>
  <table class="data-table scorecard-table">
    <thead>
      <tr>
        <th>Dimension</th>
        <th>Current Score</th>
        <th>Classification</th>
        {% if dimensions[0].prior_score is not none %}
        <th>Prior Score</th>
        <th>Movement</th>
        {% endif %}
      </tr>
    </thead>
    <tbody>
      {% for dim in dimensions %}
      <tr class="dimension-row classification-{{ dim.classification | lower | replace(' ', '-') }}">
        <td>{{ dim.name }}</td>
        <td class="score-value" data-classification="{{ dim.classification }}">{{ dim.score }}</td>
        <td>{{ dim.classification }}</td>
        {% if dim.prior_score is not none %}
        <td>{{ dim.prior_score }}</td>
        <td class="score-delta" data-direction="{{ 'worsened' if dim.delta > 0 else ('improved' if dim.delta < 0 else 'unchanged') }}">
          {% if dim.delta > 0 %}+{{ dim.delta }}
          {% elif dim.delta < 0 %}{{ dim.delta }}
          {% else %}--
          {% endif %}
        </td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr class="composite-row">
        <td><strong>OEI Composite</strong></td>
        <td class="score-value composite" data-classification="{{ composite_class }}"><strong>{{ oei_composite_score }}</strong></td>
        <td><strong>{{ composite_class }}</strong></td>
        {% if prior_composite_score is not none %}
        <td>{{ prior_composite_score }}</td>
        <td class="score-delta" data-direction="{{ score_direction }}">
          <strong>
            {% if score_delta > 0 %}+{{ score_delta }}
            {% elif score_delta < 0 %}{{ score_delta }}
            {% else %}--
            {% endif %}
          </strong>
        </td>
        {% endif %}
      </tr>
    </tfoot>
  </table>
  <p class="score-description">{{ composite_description }}</p>
</section>

{# =========================================================================
   SECTION 4 -- EXECUTIVE SUMMARY (AI NARRATIVE -- GOVERNED)
   Three-paragraph structure governed by SDLC spec Part 5 prompt.
   P1: Composite score movement and operational intelligence posture.
   P2: Single most material finding and its business implication.
   P3: One governance action most likely to produce measurable improvement
       in the next 30 days.
   ========================================================================= #}
<section id="executive-summary" data-section="executive_summary" class="report-section narrative-section">
  <h2>Executive Summary</h2>
  <div class="narrative-body governed-narrative">
    {{ narrative_executive_summary }}
  </div>
</section>

{# =========================================================================
   SECTION 5 -- SIGNAL MOVEMENT TABLE
   ========================================================================= #}
<section id="signal-movement" data-section="signal_movement" class="report-section">
  <h2>Signal Readings</h2>
  {% if breached_signals %}
  <h3>Active Threshold Breaches ({{ breached_signals | length }})</h3>
  <table class="data-table signal-table breach-table">
    <thead>
      <tr>
        <th>Signal</th>
        <th>Measured Value</th>
        <th>Watch Threshold</th>
        <th>Severity</th>
      </tr>
    </thead>
    <tbody>
      {% for sig in breached_signals %}
      <tr class="severity-{{ sig.severity }}">
        <td>{{ sig.display_name }}</td>
        <td class="numeric">{{ "%.4f" | format(sig.signal_value) }}</td>
        <td class="numeric">{{ "%.4f" | format(sig.threshold_value) }}</td>
        <td class="severity-label severity-{{ sig.severity }}">{{ sig.severity | upper }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="section-note">No signals are currently in breach for this period.</p>
  {% endif %}

  {% if cleared_signals %}
  <h3>Signals Cleared This Period ({{ cleared_signals | length }})</h3>
  <table class="data-table signal-table cleared-table">
    <thead>
      <tr>
        <th>Signal</th>
        <th>Current Value</th>
        <th>Watch Threshold</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      {% for sig in cleared_signals %}
      <tr class="severity-clear">
        <td>{{ sig.display_name }}</td>
        <td class="numeric">{{ "%.4f" | format(sig.signal_value) }}</td>
        <td class="numeric">{{ "%.4f" | format(sig.threshold_value) }}</td>
        <td class="severity-label severity-clear">CLEAR</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  <h3>All Signal Readings This Period</h3>
  <table class="data-table signal-table full-signal-table">
    <thead>
      <tr>
        <th>Signal</th>
        <th>Measured Value</th>
        <th>Watch Threshold</th>
        <th>Breach</th>
        <th>Severity</th>
      </tr>
    </thead>
    <tbody>
      {% for sig in signal_readings %}
      <tr class="severity-{{ sig.severity }}">
        <td>{{ sig.display_name }}</td>
        <td class="numeric">{{ "%.4f" | format(sig.signal_value) }}</td>
        <td class="numeric">{{ "%.4f" | format(sig.threshold_value) }}</td>
        <td class="breach-indicator">{{ "Yes" if sig.threshold_breached else "No" }}</td>
        <td class="severity-label severity-{{ sig.severity }}">{{ sig.severity | upper }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

{# =========================================================================
   SECTION 6 -- DIMENSION DEEP DIVES (AI NARRATIVE, per breached dimension)
   Only dimensions with non-empty deep-dive text are rendered.
   Dimensions with no material movement have an empty string value
   in narrative_dimension_deep_dives and are skipped.
   ========================================================================= #}
{% set has_deep_dives = namespace(value=false) %}
{% for dim in dimensions %}
  {% if narrative_dimension_deep_dives.get(dim.dimension_id) %}
    {% set has_deep_dives.value = true %}
  {% endif %}
{% endfor %}

{% if has_deep_dives.value %}
<section id="dimension-deep-dives" data-section="dimension_deep_dives" class="report-section narrative-section">
  <h2>Dimension Analysis</h2>
  {% for dim in dimensions %}
    {% set deep_dive_text = narrative_dimension_deep_dives.get(dim.dimension_id, "") %}
    {% if deep_dive_text %}
    <div class="dimension-deep-dive" data-dimension="{{ dim.dimension_id }}">
      <h3>{{ dim.name }} (Score: {{ dim.score }} -- {{ dim.classification }})</h3>
      <div class="narrative-body">{{ deep_dive_text }}</div>
    </div>
    {% endif %}
  {% endfor %}
</section>
{% endif %}

{# =========================================================================
   SECTION 7 -- ACTIVE ALERTS SUMMARY
   ========================================================================= #}
<section id="active-alerts" data-section="active_alerts" class="report-section">
  <h2>Active Alerts</h2>
  {% if active_alerts %}
  <table class="data-table alerts-table">
    <thead>
      <tr>
        <th>Signal</th>
        <th>Severity</th>
        <th>Triggered</th>
        <th>Acknowledged</th>
        <th>Intelligence Note</th>
      </tr>
    </thead>
    <tbody>
      {% for alert in active_alerts %}
      <tr class="alert-row severity-{{ alert.severity }}">
        <td>{{ alert.display_name }}</td>
        <td class="severity-label severity-{{ alert.severity }}">{{ alert.severity | upper }}</td>
        <td>{{ alert.triggered_at }}</td>
        <td>{{ "Yes" if alert.acknowledged else "No" }}</td>
        <td class="alert-message-cell">{{ alert.alert_message }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="section-note">No active unacknowledged alerts for this period.</p>
  {% endif %}
</section>

{# =========================================================================
   SECTION 8 -- QUALITATIVE INTELLIGENCE NOTES (conditional)
   Only rendered when qualitative_notes list is non-empty.
   Journal entries are internal to Criterion Partners and never shown
   to the client in raw form. Managing Partner controls what surfaces here.
   ========================================================================= #}
{% if qualitative_notes %}
<section id="intelligence-notes" data-section="intelligence_notes" class="report-section">
  <h2>Engagement Intelligence Notes</h2>
  <p class="section-note">
    The following observations were recorded during the engagement period
    and inform the findings presented in this report.
  </p>
  {% for note in qualitative_notes %}
  <div class="journal-entry materiality-{{ note.materiality | lower }}">
    <div class="journal-meta">
      <span class="journal-date">{{ note.entry_date }}</span>
      <span class="journal-type">{{ note.entry_type }}</span>
      {% if note.program_reference and note.program_reference != "General" %}
      <span class="journal-program">Re: {{ note.program_reference }}</span>
      {% endif %}
      <span class="journal-materiality">Materiality: {{ note.materiality }}</span>
    </div>
    <div class="journal-text">{{ note.intelligence_note }}</div>
  </div>
  {% endfor %}
</section>
{% endif %}

{# =========================================================================
   SECTION 9 -- FORWARD FOCUS (AI NARRATIVE)
   ========================================================================= #}
<section id="forward-focus" data-section="forward_focus" class="report-section narrative-section">
  <h2>Forward Focus</h2>
  <div class="narrative-body">
    {{ narrative_forward_focus }}
  </div>
</section>

{# =========================================================================
   PAGE FOOTER -- WATERMARK (appears on every page via builder logic)
   ========================================================================= #}
<footer id="report-footer" data-section="watermark" class="report-footer">
  <span class="watermark-text">
    Prepared exclusively for {{ sponsor_name }} -- Confidential |
    {{ client_name }} | {{ report_date }} | Report ID: {{ report_id }}
  </span>
  <span class="confidentiality-statement">
    Criterion Partners Operational Executive Intelligence --
    Proprietary and Confidential. Not for distribution.
  </span>
</footer>

</body>
</html>
